# Supabase project (Option A: managed, Region Zürich – siehe Architektur §3.4)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Deep-Link-Schema für Magic-Link-Rückkehr auf iOS/Android
VITE_APP_SCHEME=ch.myclub.nexus

# Redirect-Ziel im Browser/PWA (leer = window.location.origin).
# Betrieben läuft die App auf https://app.my-club.ch – leer lassen genügt
# dort, die Adresse muss aber in den Auth-Redirect-URLs stehen.
VITE_WEB_REDIRECT_URL=

# Öffentlicher VAPID-Schlüssel für Web Push (UC-028 A1, Versand seit UC-052).
# Leer = Geräte lassen sich nicht anmelden; die Inbox bleibt vollständig.
#
# Erzeugen: npx web-push generate-vapid-keys
# Der **private** Teil gehört dem Versanddienst und darf nie in diese Datei:
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... \
#                        VAPID_SUBJECT=mailto:...
#
# Vite setzt den Wert beim **Bauen** ein: Wer ihn nachträglich ändert, muss neu
# bauen – im Browser wie in den nativen Apps (`npm run sync`).
VITE_VAPID_PUBLIC_KEY=
